{
  "name": "pinote",
  "version": "0.7.0",
  "private": true,
  "description": "A lightweight floating markdown scratchpad app",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "pnpm build:web",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "format": "pnpm format:web && pnpm format:config && pnpm format:rust",
    "format:check": "pnpm format:web:check && pnpm format:config:check && pnpm format:rust:check",
    "format:config": "pnpm format:prettier && pnpm format:toml",
    "format:config:check": "pnpm format:prettier:check && pnpm format:toml:check",
    "format:web": "biome format --write .",
    "format:web:check": "biome format .",
    "format:prettier": "prettier --write \"**/*.{yml,yaml,html,md,markdown}\" \"!**/pnpm-lock.yaml\" \"!**/target/**\" --ignore-path .gitignore --ignore-path .git/info/exclude",
    "format:prettier:check": "prettier --check \"**/*.{yml,yaml,html,md,markdown}\" \"!**/pnpm-lock.yaml\" \"!**/target/**\" --ignore-path .gitignore --ignore-path .git/info/exclude",
    "format:toml": "tombi format",
    "format:toml:check": "tombi format --check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "pnpm check:config && pnpm check:web && pnpm check:rust",
    "check:config": "tombi lint && actionlint && pnpm exec lefthook validate",
    "check:web": "biome check --formatter-enabled=false src && pnpm typecheck",
    "check:web:write": "biome check --formatter-enabled=false --write src",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked -- -D warnings",
    "check:rust:release": "cd src-tauri && cargo check --release",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:web && pnpm test:rust",
    "test:web": "vitest run --dir src",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "release": "cd src-tauri && cargo release",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@types/node": "^25.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.564.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.9",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.6.0",
    "happy-dom": "20.14.0",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "tombi": "1.5.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "4.1.10"
  }
}
